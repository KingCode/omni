
{:deps {
        org.clojure/clojure {:mvn/version "1.12.5"}
}

 :paths ["src"]

 :aliases 
 {
  ;; clj -T:build <fn>  (build a jar, using tools.build)
  :build {:deps 
          {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          ;; see build.clj
          :ns-default build}

  ;; clj -X:deploy  (deploy to Clojars, replaces Leiningen's :deploy-repositories)
  :deploy 
  {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
   :exec-fn deps-deploy.deps-deploy/deploy
   :exec-args 
   {:installer :remote
    :artifact "target/omni.cond-utils-0.1.0-SNAPSHOT.jar"
    :pom-file 
   "target/classes/META-INF/maven/org.clojars.kingnuscodus/omni.cond-utils/pom.xml"}}
}}
